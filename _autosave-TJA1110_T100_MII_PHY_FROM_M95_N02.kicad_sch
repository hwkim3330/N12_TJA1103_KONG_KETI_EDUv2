	(text "PHY_EN INPUT = 0 : Low Power, Disabled State.\nSupport Sleep and Wakeup functionality.\nWhen the PHY is enabled (EN = High), \nthe INH pin can turn on the main power supply, \nproviding power to the rest of the node.\n*Wake-Up Sequence: To wake up the TJA1101, \nthe host brings the EN pin high, allowing the PHY to resume operation \nand re-establish the 100BASE-T1 link.\n*VCONT DOMAIN\n"
		(exclude_from_sim no)
		(at 103.124 87.122 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8e8e0f73-7e63-4e24-8347-21cb5d677e1e")
	)
